{
  "manifest_version": 3,
  "name": "qooti",
  "description": "Save images and videos to your qooti library with one click.",
  "version": "1.2.1",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "qooti"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "*://*.bloot.app/*",
        "*://*.bloot-admin.pages.dev/*",
        "*://*.bloot-dashboard.pages.dev/*",
        "*://*.bloot-landing.pages.dev/*"
      ],
      "js": [
        "i18n.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "contextMenus",
    "clipboardWrite",
    "activeTab",
    "alarms",
    "unlimitedStorage"
  ],
  "optional_permissions": [
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1:1420/*"
  ],
  "optional_host_permissions": [
    "https://*.instagram.com/*",
    "https://*.tiktok.com/*"
  ]
}
