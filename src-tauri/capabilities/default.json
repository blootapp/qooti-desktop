{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for qooti desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "shell:allow-open",
    "fs:default",
    "dialog:default",
    "notification:default",
    "process:allow-exit",
    "process:allow-restart",
    "deep-link:default"
  ]
}
